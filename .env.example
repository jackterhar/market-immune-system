# LA CRE Opportunity Screener — optional configuration.
# Copy to .env (git-ignored) or export these in your shell.

# Optional. Raises Socrata rate limits. Free from https://data.lacounty.gov
SOCRATA_APP_TOKEN=

# ── MLS (RESO Web API) ───────────────────────────────────────────────────
# Optional. The dashboard is fully functional on public records without it.
#
# LICENSING: MLS data is licensed, not public. IDX/VOW rules generally
# prohibit republishing it publicly. Keep an MLS-enabled build private —
# do not deploy it to a public URL. Your participation agreement governs.

# Bridge:  https://api.bridgedataoutput.com/api/v2/OData/<dataset>
# Trestle: https://api-prod.corelogic.com/trestle/odata
MLS_BASE_URL=

# bearer | oauth2 | query
MLS_AUTH_MODE=bearer

# For bearer / query modes
MLS_TOKEN=

# For oauth2 mode
MLS_CLIENT_ID=
MLS_CLIENT_SECRET=
MLS_TOKEN_URL=
MLS_SCOPE=
